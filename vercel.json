{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)\\.map",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)\\.map",
      "destination": "/404",
      "statusCode": 404
    },
    {
      "source": "/apply",
      "destination": "https://agile-recruitment.codewords.run/",
      "permanent": false
    },
    {
      "source": "/mobile",
      "destination": "https://agilegroup-work360.aititude.in/",
      "permanent": false
    },
    {
      "source": "/mobile/:path*",
      "destination": "https://agilegroup-work360.aititude.in/:path*",
      "permanent": false
    },
    {
      "source": "/manus",
      "destination": "/manus-closed.html",
      "permanent": true
    },
    {
      "source": "/manus/:path*",
      "destination": "/manus-closed.html",
      "permanent": true
    },
    {
      "source": "/old-mis",
      "destination": "/manus-closed.html",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/admin", "has": [{ "type": "host", "value": "securityjob.co.in" }], "destination": "/api/securityjob/admin" },
    { "source": "/admin/", "has": [{ "type": "host", "value": "securityjob.co.in" }], "destination": "/api/securityjob/admin" },
    { "source": "/admin", "has": [{ "type": "host", "value": "www.securityjob.co.in" }], "destination": "/api/securityjob/admin" },
    { "source": "/admin/", "has": [{ "type": "host", "value": "www.securityjob.co.in" }], "destination": "/api/securityjob/admin" },
    { "source": "/((?!api/|securityjob/).*)", "has": [{ "type": "host", "value": "securityjob.co.in" }], "destination": "/api/securityjob/site" },
    { "source": "/((?!api/|securityjob/).*)", "has": [{ "type": "host", "value": "www.securityjob.co.in" }], "destination": "/api/securityjob/site" },
    { "source": "/pulse/admin", "destination": "/api/pulse/admin" },
    { "source": "/pulse/whatsapp-link", "destination": "/api/pulse/whatsapp-link" },
    { "source": "/pulse/whatsapp-link/", "destination": "/api/pulse/whatsapp-link" },
