{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)\\.map",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)\\.map",
      "destination": "/404",
      "statusCode": 404
    },
    {
      "source": "/apply",
      "destination": "https://agile-recruitment.codewords.run/",
      "permanent": false
    },
    {
      "source": "/mobile",
      "destination": "https://agilegroup-work360.aititude.in/",
      "permanent": false
    },
    {
      "source": "/mobile/:path*",
      "destination": "https://agilegroup-work360.aititude.in/:path*",
      "permanent": false
    },
    {
      "source": "/manus",
      "destination": "/manus-closed.html",
      "permanent": true
    },
    {
      "source": "/manus/:path*",
      "destination": "/manus-closed.html",
      "permanent": true
    },
    {
      "source": "/old-mis",
      "destination": "/manus-closed.html",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/pulse/admin", "destination": "/api/pulse/admin" },
    { "source": "/fleets", "destination": "/api/fleet/app" },
    { "source": "/fleets/", "destination": "/api/fleet/app" },
    { "source": "/recruitment", "destination": "/api/recruitment/app" },
    { "source": "/recruitment/", "destination": "/api/recruitment/app" },
    { "source": "/deployment", "destination": "/api/deployment/gate" },
    { "source": "/deployment/", "destination": "/api/deployment/gate" },
    { "source": "/reviews", "destination": "/api/reviews/gate" },
    { "source": "/reviews/", "destination": "/api/reviews/gate" },
    { "source": "/training", "destination": "/api/training/gate" },
    { "source": "/training/", "destination": "/api/training/gate" },
    { "source": "/pulse/admin/", "destination": "/api/pulse/admin" },
    { "source": "/pulse", "destination": "/api/pulse/bulletin" },
    { "source": "/pulse/", "destination": "/api/pulse/bulletin" },
    { "source": "/securityjob/admin", "destination": "/api/securityjob/admin" },
    { "source": "/securityjob/admin/", "destination": "/api/securityjob/admin" },
    { "source": "/securityjob", "destination": "/api/securityjob/site" },
    { "source": "/securityjob/", "destination": "/api/securityjob/site" },
    { "source": "/mis-unit-issue", "destination": "/api/mis/unit-issue" },
    { "source": "/mis-unit-issue/", "destination": "/api/mis/unit-issue" },
    { "source": "/mis-guard-docs", "destination": "/api/mis/guard-docs" },
    { "source": "/mis-guard-docs/", "destination": "/api/mis/guard-docs" },
    { "source": "/mis-report", "destination": "/api/mis/report" },
    { "source": "/mis-report/", "destination": "/api/mis/report" },
    { "source": "/mis-staff", "destination": "/api/mis/staff" },
    { "source": "/mis-staff/", "destination": "/api/mis/staff" },
    { "source": "/mis-staff-daily", "destination": "/api/mis/staff?page=daily" },
    { "source": "/mis-staff-daily/", "destination": "/api/mis/staff?page=daily" },
    { "source": "/mis-staff-daily-deploy", "destination": "/api/mis/staff?page=daily-deploy" },
    { "source": "/mis-staff-daily-deploy/", "destination": "/api/mis/staff?page=daily-deploy" },
