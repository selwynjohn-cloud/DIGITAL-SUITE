  "crons": [
    { "path": "/api/pulse/cron", "schedule": "*/30 * * * *" },
    { "path": "/api/crm/cron", "schedule": "30 4 * * 6" },
    { "path": "/api/crm/cron", "schedule": "30 9 * * 6" },
    { "path": "/api/fleet/cron", "schedule": "30 4 * * 6" },
    { "path": "/api/fleet/cron", "schedule": "0 11 * * 6" },
    { "path": "/api/fleet/cron", "schedule": "30 4 * * 0" },
    { "path": "/api/mis/cron?job=missing-acks", "schedule": "30 6 * * *" },
    { "path": "/api/mis/cron?job=missing-acks", "schedule": "30 12 * * *" },
    { "path": "/api/mis/cron?job=morning-reminder", "schedule": "30 5 * * *" },
    { "path": "/api/mis/cron?job=midday-reminder", "schedule": "30 8 * * *" },
    { "path": "/api/mis/cron?job=consolidated-ack", "schedule": "30 11 * * *" },
    { "path": "/api/mis/cron", "schedule": "30 12 * * *" },
    { "path": "/api/mis/cron", "schedule": "0 1 * * *" },
    { "path": "/api/mis/cron", "schedule": "30 13 * * *" },
    { "path": "/api/mis/cron?job=complaint-sync", "schedule": "0 3 * * *" },
    { "path": "/api/mis/cron?job=complaint-sync", "schedule": "30 15 * * *" },
    { "path": "/api/pulse/winner-cron", "schedule": "30 2 * * 0" },
