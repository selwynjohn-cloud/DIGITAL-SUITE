# Fast2SMS Dev API key — https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=

# Recipient (10-digit India mobile). Selwyn: 9441009091
BULLETIN_TO=9441009091

# whatsapp | sms | auto  (auto = WhatsApp then Quick SMS fallback)
BULLETIN_CHANNEL=whatsapp

# Optional — auto-resolved from Fast2SMS WABA if blank
FAST2SMS_PHONE_NUMBER_ID=
FAST2SMS_MESSAGE_ID=

# Optional template variables joined by |  (defaults to date|headline)
# BULLETIN_VARIABLES=1 Aug 2026|New security guard vacancies near you
